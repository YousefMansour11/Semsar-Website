# Root .gitignore — monorepo-wide ignores

# --- .NET / build output ---
bin/
obj/
out/
publish/
publish2/
TestResults/
coverage/
*.trx
*.nupkg
*.snupkg
packages/
project.lock.json
*.user
*.suo
*.userosscache
.vs/
.idea/

# --- Node / JS deps & build ---
node_modules/
dist/
dist-ssr/
.next/
out/
*.local

# --- Environment & secrets ---
.env
.env.*
!.env.example
secrets.json
appsettings.Development.json
local.settings.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Misc ---
*.mdf
*.ldf
*.pfx
dataprotection-keys/
temp_swagger.json
stats.html

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json